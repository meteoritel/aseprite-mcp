ASEPRITE_PATH=/path/to/aseprite

# --- Optional: directory that relative filenames resolve against ---
# Set this to your AI project folder (usually via the client's .mcp.json
# "env" so it is per-project). Unset = server's working directory.
# ASERITE_MCP_WORKSPACE=/path/to/your/project

# --- Optional: client-liveness watchdog ---
# On by default: the server exits when its MCP client goes away, so it cannot
# pile up as an orphan that only `taskkill /T /F` can clear. The client's end of
# stdin is the signal (parent death is only a fallback where stdin cannot
# answer, e.g. macOS), so a session stays up while its stdin is open no matter
# what its parent does. Set to 0 when embedding the server under a non-MCP
# parent that is expected to outlive it.
# ASEPRITE_MCP_CLIENT_WATCHDOG=0

# --- Optional: Install Aseprite from Steam within container ---
# Provide these to enable runtime install using SteamCMD.
# WARNING: Prefer using `docker run --env-file` or secrets; do not bake credentials.
# STEAM_USERNAME=your_steam_username
# STEAM_PASSWORD=your_steam_password
# If Steam Guard is enabled:
# STEAM_GUARD_CODE=XXXXX
# Optional overrides:
# STEAM_APPID=431730
# STEAM_INSTALL_DIR=/opt/steamapps